# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── CMS (MDX — no external service needed) ──────────────────────────────────
# Content lives in /content/**/*.mdx — fully free, version-controlled.
# No API keys required.

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=hello@researchvy.com

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Super Admin ──────────────────────────────────────────────────────────────
# Email address that gets platform owner privileges (assign/revoke admin roles).
# Must be set in Vercel env vars for the super admin crown and actions to work.
SUPER_ADMIN_EMAIL=your_super_admin_email@example.com

# ─── Cron Jobs (Vercel Cron) ─────────────────────────────────────────────────
# All /api/cron/* and /api/email-sequence routes require this secret.
# Set the same value in Vercel Dashboard → Settings → Environment Variables.
# Generate one with: openssl rand -hex 32
CRON_SECRET=your_strong_random_secret_here

# ─── Setup Admin (one-time bootstrap route) ───────────────────────────────────
# Used by POST /api/setup-admin to create the first admin account.
# Remove or leave unset after initial setup — the route returns 403 when empty.
# Generate one with: openssl rand -hex 32
SETUP_ADMIN_SECRET=your_setup_admin_secret_here

# ─── Bank Transfer Payment ───────────────────────────────────────────────────
# Shown on the payment confirmation page when the user selects bank transfer.
BANK_ACCOUNT_NAME=Your Account Name Here
BANK_ACCOUNT_NUMBER=0000000000
BANK_NAME=Your Bank Name Here

# ─── OPay (Nigerian payment gateway — optional, disabled by default) ──────────
# Set opay.enabled = true in constants/payment.ts to activate.
# Obtain credentials from https://opayweb.com/
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_APP_ID=your_opay_app_id
OPAY_SECRET_KEY=your_opay_secret_key
OPAY_ENV=sandbox

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Social Auth — Google ─────────────────────────────────────────────────────
# Setup: Supabase Dashboard → Auth → Providers → Google
#   1. Enable Google provider, paste Client ID + Secret from Google Cloud Console
#   2. In Google Cloud Console → Credentials → Authorised redirect URIs add:
#      https://<your-project>.supabase.co/auth/v1/callback
# Then set this to "true" to show the Google button on sign-in/sign-up
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ─── Social Auth — LinkedIn ───────────────────────────────────────────────────
# Setup: Supabase Dashboard → Auth → Providers → LinkedIn (OIDC)
#   1. Create a LinkedIn app at https://developer.linkedin.com
#   2. Products: "Sign In with LinkedIn using OpenID Connect"
#   3. Add OAuth 2.0 redirect URL: https://<your-project>.supabase.co/auth/v1/callback
#   4. Paste Client ID + Secret into Supabase dashboard
# Then set this to "true" to show the LinkedIn button
NEXT_PUBLIC_LINKEDIN_AUTH_ENABLED=false

# ─── ORCID OAuth (researcher identity verification + sign-in) ─────────────────
# Register at https://orcid.org/developer-tools — choose Sandbox for dev, Production for live.
# Redirect URI to register: https://researchvy.com/api/auth/orcid/callback
# This is a custom OAuth flow (Supabase doesn't natively support ORCID).
ORCID_CLIENT_ID=APP-your_client_id_here
ORCID_CLIENT_SECRET=your_client_secret_here
# Set to "true" to show the ORCID button on sign-in/sign-up and profile page
NEXT_PUBLIC_ORCID_ENABLED=false

# ─── Web Push (browser push notifications — no native app required) ───────────
# Generate a VAPID key pair once with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is safe to expose (client-side subscription key)
# VAPID_PRIVATE_KEY must stay server-side only — never prefix with NEXT_PUBLIC_
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ─── Rate Limiting (Upstash Redis — required in production) ──────────────────
# Without these, rate limiting falls back to allow-all (safe for local dev).
# Create a Redis database at https://console.upstash.com/ → copy REST URL + token.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── Africa's Talking (SMS / WhatsApp notifications — optional) ───────────────
# Register at https://africastalking.com/ and create an application.
# Leave blank to disable SMS/WhatsApp sending — email notifications still work.
AFRICAS_TALKING_API_KEY=your_api_key_here
AFRICAS_TALKING_USERNAME=your_username_here
AFRICAS_TALKING_WHATSAPP_SENDER=your_sender_number_here

# ─── Admin WhatsApp (receives critical platform alerts) ───────────────────────
# Format: country code + number, no + prefix (e.g. 2347030515183)
ADMIN_WHATSAPP_PHONE=2347030515183
